# Application Port & Mode
PORT=3010
NODE_ENV=development
APP_NAME=hieronymus-dev

# PostgreSQL Connection Variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=hieronymus
DB_PASSWORD=hieronymus
DB_NAME=hieronymus_dev
DB_TEST_NAME=hieronymus_test
DB_SCHEMA=public
DB_LOGGING=false

# Or single DATABASE_URL connection string
# DATABASE_URL=postgres://hieronymus:hieronymus@localhost:5432/hieronymus_dev

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010